# =============================================================================
# Ashish Traders Fireworks - URL Rewrite Rules for Apache & Hostinger
# Maps Node.js-style /api/... endpoints to PHP files
# =============================================================================

RewriteEngine On

# API endpoint rewrites: /api/data -> /api/data.php
RewriteRule ^api/data/?$ api/data.php [L,QSA]
RewriteRule ^api/save/?$ api/save.php [L,QSA]
RewriteRule ^api/upload/?$ api/upload.php [L,QSA]
RewriteRule ^api/upload-base64/?$ api/upload-base64.php [L,QSA]
RewriteRule ^api/review/submit/?$ api/review-submit.php [L,QSA]

<IfModule mod_php7.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 25M
  php_value max_execution_time 60
</IfModule>

<IfModule mod_php.c>
  php_value upload_max_filesize 20M
  php_value post_max_size 25M
  php_value max_execution_time 60
</IfModule>
